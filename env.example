# Copy to .env for local work. On Render put these under Environment.
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-me
ALLOWED_HOSTS=kiliwildadventure.com,www.kiliwildadventure.com

# Supabase -> Project Settings -> Database -> Connection string (Session pooler)
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase Storage (PUBLIC bucket) -> Storage -> Settings -> S3 access keys
SUPABASE_PROJECT_REF=         # the <ref> in https://<ref>.supabase.co
SUPABASE_BUCKET=kiliwild
SUPABASE_S3_REGION=eu-central-1
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=

